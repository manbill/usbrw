<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- 受限 entitlement:需 Apple Developer 后台开通 FSKit capability 并由
         provisioning profile 授权,否则 AMFI 拒绝加载扩展。 -->
    <key>com.apple.developer.fskit.fsmodule</key>
    <true/>
    <!-- App Group:与宿主 app 共享设置(默认只读挂载偏好)。 -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>87LTRAZ45P.group.com.usbrw.shared</string>
    </array>
</dict>
</plist>
